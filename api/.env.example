# ------------------------------------------------------------------
# Configuracion de la API de Aburra Motors
# Copia este archivo a .env y ajusta los valores. NUNCA commitees .env
# ------------------------------------------------------------------

# Nombre y entorno de ejecucion: local | staging | production
APP_NAME="Aburra Motors API"
APP_ENV=local
APP_DEBUG=true

# Cadena de conexion de la base de datos.
# Desarrollo (SQLite, por defecto):
DATABASE_URL=sqlite:///./aburra_motors.db
# Produccion (PostgreSQL) - basta cambiar esta variable, no hay codigo que tocar:
# DATABASE_URL=postgresql+psycopg://usuario:password@localhost:5432/aburra_motors

# Origenes permitidos por CORS, separados por coma.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Paginacion del catalogo
PAGE_SIZE_DEFAULT=12
PAGE_SIZE_MAX=100

# Logging: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
LOG_JSON=true

# Tasa mensual por defecto del simulador de credito (en porcentaje).
# Debe coincidir con web/src/config/site.ts -> financiacion.tasaMensualPorDefecto
TASA_MENSUAL_POR_DEFECTO=1.45
